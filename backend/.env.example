# --- Core ---
SONIC_ENV=dev
SONIC_SECRET_KEY=change-me-in-prod
SONIC_DATABASE_URL=postgresql+asyncpg://sonic:sonic@localhost:5432/sonic
SONIC_REDIS_URL=redis://localhost:6379/0
SONIC_CORS_ORIGINS=["http://localhost:5180"]

# --- Object storage (MinIO / S3). STORAGE_BACKEND=local writes to ./data instead. ---
SONIC_STORAGE_BACKEND=s3
SONIC_S3_ENDPOINT_URL=http://localhost:9000
SONIC_S3_ACCESS_KEY=sonic
SONIC_S3_SECRET_KEY=sonic-secret
SONIC_S3_BUCKET=sonic-audio

# --- Pipeline feature flags (each stage has a cheap fallback when disabled/unavailable) ---
SONIC_ENABLE_ASR=true
SONIC_ASR_MODEL=base
SONIC_ENABLE_DIARIZATION=true
SONIC_ENABLE_EMOTION=true
SONIC_ENABLE_NLP=true
SONIC_ENABLE_LLM=true
SONIC_ENABLE_QA=true
SONIC_ENABLE_PREDICTION=true
SONIC_ENABLE_INDEXING=true

# --- External model credentials (all optional; stages skip gracefully without them) ---
ANTHROPIC_API_KEY=
SONIC_LLM_MODEL=claude-sonnet-5
HF_TOKEN=
